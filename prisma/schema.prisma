generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model User {
    id        Int       @id @default(autoincrement())
    name      String
    email     String    @unique
    password  String
    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt
}

model Customer {
    id         Int       @id @default(autoincrement())
    name       String
    type       String // Individual or Business
    email      String    @unique
    address    String
    city       String
    state      String
    postalCode String
    createdAt  DateTime  @default(now())
    updatedAt  DateTime?  @updatedAt
    invoices   Invoice[]
}

model Invoice {
    id         Int       @id @default(autoincrement())
    customerId Int
    amount     Int
    status     String
    billedDate DateTime
    paidDate   DateTime? // Nullable field
    createdAt  DateTime  @default(now())
    updatedAt  DateTime?  @updatedAt

    customer Customer @relation(fields: [customerId], references: [id])
}
